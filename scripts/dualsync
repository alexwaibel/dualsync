#!/bin/sh

set -eu

PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export DUALSYNC_UID
export DUALSYNC_GID
DUALSYNC_UID=$(id -u)
DUALSYNC_GID=$(id -g)

compose()
{
    docker compose --project-directory "$PROJECT_ROOT" -f "$PROJECT_ROOT/compose.yaml" "$@"
}

run_tools()
{
    compose run --no-TTY --rm --build tools "$@"
}

run_dsi()
{
    compose run --no-TTY --rm --build dsi "$@"
}

command=${1:-}

case "$command" in
    check)
        run_tools cmake --workflow --preset host-check
        run_dsi cmake --workflow --preset dsi
        ;;
    clean)
        rm -rf "$PROJECT_ROOT/build"
        ;;
    dsi)
        run_dsi cmake --workflow --preset dsi
        ;;
    format)
        run_tools cmake --preset host
        run_tools cmake --build --preset host-format
        ;;
    format-check)
        run_tools cmake --preset host
        run_tools cmake --build --preset host-format-check
        ;;
    lint)
        run_tools cmake --preset host
        run_tools cmake --build --preset host-lint
        ;;
    install-hooks)
        git -C "$PROJECT_ROOT" config core.hooksPath .githooks
        echo "Configured Git hooks from .githooks"
        ;;
    test)
        run_tools cmake --workflow --preset host-check
        ;;
    tidy)
        run_tools cmake --preset host
        run_tools cmake --build --preset host-tidy
        ;;
    versions)
        run_tools sh -lc '
            clang-16 --version | head -n 1
            cmake --version | head -n 1
            ninja --version
            cppcheck --version
        '
        run_dsi sh -lc '
            "$WONDERFUL_TOOLCHAIN/toolchain/gcc-arm-none-eabi/bin/arm-none-eabi-gcc" \
                --version | head -n 1
            wf-pacman -Q blocksds-libcurl blocksds-mbedtls \
                toolchain-gcc-arm-none-eabi-zlib
        '
        ;;
    *)
        echo "Usage: $0 {check|clean|dsi|format|format-check|install-hooks|lint|test|tidy|versions}" >&2
        exit 2
        ;;
esac
