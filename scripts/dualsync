#!/bin/sh

set -eu

PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export DUALSYNC_UID
export DUALSYNC_GID
DUALSYNC_UID=$(id -u)
DUALSYNC_GID=$(id -g)

compose()
{
    docker compose --project-directory "$PROJECT_ROOT" -f "$PROJECT_ROOT/compose.yaml" "$@"
}

run_dev()
{
    if [ "${DUALSYNC_IN_CONTAINER:-0}" = "1" ]; then
        "$@"
    else
        compose run --no-TTY --rm --build \
            --user "$DUALSYNC_UID:$DUALSYNC_GID" \
            --env HOME=/tmp \
            dev "$@"
    fi
}

command=${1:-}

case "$command" in
    check)
        run_dev sh -lc '
            cmake --workflow --preset host-check
            cmake --workflow --preset dsi
        '
        ;;
    clean)
        rm -rf "$PROJECT_ROOT/build"
        ;;
    dsi)
        run_dev cmake --workflow --preset dsi
        ;;
    format)
        run_dev sh -lc '
            cmake --preset host
            cmake --build --preset host-format
        '
        ;;
    format-check)
        run_dev sh -lc '
            cmake --preset host
            cmake --build --preset host-format-check
        '
        ;;
    lint)
        run_dev sh -lc '
            cmake --preset host
            cmake --build --preset host-lint
        '
        ;;
    install-hooks)
        git -C "$PROJECT_ROOT" config core.hooksPath .githooks
        echo "Configured Git hooks from .githooks"
        ;;
    test)
        run_dev cmake --workflow --preset host-check
        ;;
    tidy)
        run_dev sh -lc '
            cmake --preset host
            cmake --build --preset host-tidy
        '
        ;;
    versions)
        run_dev sh -lc '
            clang-16 --version | head -n 1
            cmake --version | head -n 1
            ninja --version
            cppcheck --version
            "$WONDERFUL_TOOLCHAIN/toolchain/gcc-arm-none-eabi/bin/arm-none-eabi-gcc" \
                --version | head -n 1
            wf-pacman -Q blocksds-libcurl blocksds-mbedtls \
                toolchain-gcc-arm-none-eabi-zlib
        '
        ;;
    *)
        echo "Usage: $0 {check|clean|dsi|format|format-check|install-hooks|lint|test|tidy|versions}" >&2
        exit 2
        ;;
esac
