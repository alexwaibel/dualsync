{
  "name": "DualSync",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "options": [
      "--cache-from=ghcr.io/alexwaibel/dualsync-devcontainer:cache"
    ]
  },
  "workspaceFolder": "/work",
  "workspaceMount": "source=${localWorkspaceFolder},target=/work,type=bind",
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "DUALSYNC_IN_CONTAINER": "1",
    "DUALSYNC_PROBE_URL": "https://demo.romm.app/api/heartbeat"
  },
  "postCreateCommand": "./scripts/dualsync configure && ./scripts/dualsync install-hooks",
  "customizations": {
    "vscode": {
      "extensions": [
        "editorconfig.editorconfig",
        "github.vscode-github-actions",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "stkb.rewrap",
        "vadimcn.vscode-lldb"
      ]
    }
  }
}
